<?page title="CTS — Admin Dashboard" contentType="text/html;charset=UTF-8"?>
<!--
    PAGE: adminDashboard.zul
    ==========================
    Role     : Admin
    Modules  : User Management → Bank Management
    Composer : com.cts.web.composer.dashboard.AdminDashboardComposer

    Admin has NO pipeline modules — sidebar shows Admin Panel only.
    No workflowbar needed for this role.
-->
<zk>

    <!-- ── Declare reusable components ── -->
    <?component name="ctstopbar"
                macroURI="/components/topbar.zul"
                class="com.cts.web.composer.components.TopbarComposer"?>

    <?component name="ctssidebar"
                macroURI="/components/sidebar.zul"
                class="com.cts.web.composer.components.SidebarComposer"?>

    <?component name="smarttable"
                macroURI="/components/smartTable.zul"
                class="com.cts.web.composer.components.SmartTableComposer"?>

    <!-- ── Page shell window ── -->
    <window id="winAdmin"
            border="none"
            width="100%"
            height="100%"
            sclass="cts-page-shell"
            apply="com.cts.web.composer.dashboard.AdminDashboardComposer">

        <!-- TOP BAR -->
        <ctstopbar/>

        <!-- APP SHELL -->
        <hlayout sclass="app-shell" spacing="0px" width="100%">

            <!-- SIDEBAR — SidebarComposer detects Admin role, shows Admin Panel section only -->
            <ctssidebar/>

            <!-- MAIN CONTENT -->
            <div sclass="main-content" vflex="1">

                <!-- ── Page Header ── -->
                <div sclass="page-hdr">
                    <div sclass="page-hdr-left">
                        <label sclass="page-breadcrumb" value="CTS / Admin Dashboard"/>
                        <label sclass="page-title"      value="System Administration"/>
                        <label sclass="page-sub"        value="Manage users, roles, bank master, and system configuration"/>
                    </div>
                </div>

                <!-- ── KPI Stat Row ── -->
                <hlayout sclass="stat-row" spacing="12px">
                    <div sclass="stat-box blue">
                        <label id="lblTotalUsers" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"  value="Total Users"/>
                    </div>
                    <div sclass="stat-box green">
                        <label id="lblActiveUsers" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"   value="Active Users"/>
                    </div>
                    <div sclass="stat-box amber">
                        <label id="lblTotalBanks" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"  value="Banks Registered"/>
                    </div>
                    <div sclass="stat-box slate">
                        <label id="lblActiveBanks" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"   value="Active Banks"/>
                    </div>
                </hlayout>

                <!-- ── Admin Module Tiles ── -->
                <div sclass="section-lbl"><label value="ADMINISTRATION MODULES"/></div>
                <hlayout sclass="admin-grid" spacing="14px">

                    <div sclass="admin-tile" onClick="@command('navigate', page='admin-users')">
                        <div sclass="admin-tile-icon" style="background:#dbeafe">
                            <label value="👥"/>
                        </div>
                        <label sclass="admin-tile-title" value="User Management"/>
                        <label sclass="admin-tile-desc"
                               value="Create, update, deactivate users. Assign roles (Maker / Checker / Admin) and branch."/>
                        <label id="lblUserCount" sclass="admin-tile-count" value="0 users"/>
                    </div>

                    <div sclass="admin-tile" onClick="@command('navigate', page='admin-banks')">
                        <div sclass="admin-tile-icon" style="background:#d1fae5">
                            <label value="🏦"/>
                        </div>
                        <label sclass="admin-tile-title" value="Bank Management"/>
                        <label sclass="admin-tile-desc"
                               value="Manage bank master data — IFSC prefix, MICR city codes, branch counts and status."/>
                        <label id="lblBankCount" sclass="admin-tile-count" value="0 banks"/>
                    </div>

                </hlayout>

                <!-- ── Users Table ── -->
                <!--
                    Composer:
                        tableComp.setColumns(List.of(
                            new ColumnDef("username","Username",true,true),
                            new ColumnDef("fullName","Full Name",true,false),
                            new ColumnDef("role","Role",false,false),
                            new ColumnDef("branch","Branch",true,false),
                            new ColumnDef("status","Status",false,false),
                            new ColumnDef("createdDate","Created",true,true)
                        ));
                        tableComp.setData(userList);
                        tableComp.setFilterKey("role");
                        tableComp.setFilterOptions(roleFilterOpts);
                        tableComp.refresh();
                -->
                <div sclass="card-panel">
                    <div sclass="card-panel-header">
                        <label sclass="card-panel-title" value="ALL USERS"/>
                        <button id="btnAddUser"
                                label="+ Add User"
                                sclass="btn btn-primary btn-sm"
                                onClick="@command('openAddUserDialog')"/>
                    </div>
                    <div sclass="card-panel-body">
                        <smarttable id="tblUsers"/>
                    </div>
                </div>

                <!-- ── Banks Table ── -->
                <!--
                    Composer:
                        tableComp2.setColumns(List.of(
                            new ColumnDef("bankName","Bank Name",true,false),
                            new ColumnDef("ifscPrefix","IFSC Prefix",true,true),
                            new ColumnDef("micrCity","MICR City",true,true),
                            new ColumnDef("branches","Branches",true,true),
                            new ColumnDef("status","Status",false,false),
                            new ColumnDef("addedDate","Added",true,true)
                        ));
                        tableComp2.setData(bankList);
                        tableComp2.setFilterKey("status");
                        tableComp2.refresh();
                -->
                <div sclass="card-panel">
                    <div sclass="card-panel-header">
                        <label sclass="card-panel-title" value="REGISTERED BANKS"/>
                        <button id="btnAddBank"
                                label="+ Add Bank"
                                sclass="btn btn-primary btn-sm"
                                onClick="@command('openAddBankDialog')"/>
                    </div>
                    <div sclass="card-panel-body">
                        <smarttable id="tblBanks"/>
                    </div>
                </div>

            </div>
            <!-- /main-content -->

        </hlayout>
        <!-- /app-shell -->

    </window>

</zk>