<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
	<style src="/styling/sidebar.css"/>
    <div sclass="cts-sidebar">

        <!-- Brand -->
        <div sclass="sidebar-brand">
            <div sclass="sidebar-logo">
                <label sclass="sidebar-logo-letter" value="II"/>
            </div>
            <div sclass="sidebar-brand-text">
                <label sclass="sidebar-brand-title" value="CHEQUE TRUNCATION"/>
                <label sclass="sidebar-brand-sub"   value="NPCI · CTS GRID"/>
            </div>
        </div>

        <div sclass="sidebar-divider"/>

        <!-- Section Label -->
        <div sclass="sidebar-section-label">
            <label id="mc_lblSection" value="MENU"/>
        </div>

        <!-- Dashboard — always visible, always enabled -->
        <div id="mc_itemDashboard" sclass="sidebar-item">
            <div sclass="sidebar-step"><label value="D"/></div>
            <label sclass="sidebar-item-label" value="Dashboard"/>
        </div>

        <!-- Admin Items -->
        <div id="mc_itemUserMgmt" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="👥"/></div>
            <label sclass="sidebar-item-label" value="User Management"/>
        </div>

        <div id="mc_itemBankMgmt" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="🏦"/></div>
            <label sclass="sidebar-item-label" value="Bank Management"/>
        </div>

        <div sclass="sidebar-divider"/>

        <!-- Pipeline Items -->
        <div id="mc_item1" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="1"/></div>
            <label sclass="sidebar-item-label" value="Scan"/>
        </div>

        <div id="mc_item2" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="2"/></div>
            <label sclass="sidebar-item-label" value="Reject &amp; Repair"/>
        </div>

        <div id="mc_item3" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="3"/></div>
            <label sclass="sidebar-item-label" value="Checker Outward"/>
        </div>

        <div id="mc_item4" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="4"/></div>
            <label sclass="sidebar-item-label" value="File Processing"/>
        </div>

        <div id="mc_item5" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="5"/></div>
            <label sclass="sidebar-item-label" value="Inward Repair"/>
        </div>

        <div id="mc_item6" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="6"/></div>
            <label sclass="sidebar-item-label" value="Checker Inward"/>
        </div>

        <div id="mc_item7" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="7"/></div>
            <label sclass="sidebar-item-label" value="CBS Processing"/>
        </div>

        <div id="mc_item8" sclass="sidebar-item sidebar-disabled">
            <div sclass="sidebar-step"><label value="8"/></div>
            <label sclass="sidebar-item-label" value="Batch Status"/>
        </div>

    </div>

</zk>