<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <?link rel="stylesheet" href="/styling/topbar.css"?>

    <div sclass="cts-topbar">

        <!-- Left: Brand -->
        <div sclass="topbar-brand">
            <div sclass="topbar-logo">
                <label value="CTS" sclass="topbar-logo-text"/>
            </div>
            <div>
                <label value="Cheque Truncation System" sclass="topbar-title"/>
                <label value="NPCI · CTS Grid Processing" sclass="topbar-subtitle"/>
            </div>
        </div>

        <!-- Right: Session info + user + logout -->
        <div sclass="topbar-right">

            <!-- Session badge (hidden when no session open) -->
            <div id="mc_sessionBadge" sclass="topbar-session" visible="false">
                <label id="mc_lblSessionId"   sclass="session-id"/>
                <label value="|"              sclass="session-sep"/>
                <label id="mc_lblSessionTime" sclass="session-time"/>
                <label value="|"              sclass="session-sep"/>
                <label id="mc_lblSessionDate" sclass="session-date"/>
            </div>

            <!-- User info -->
            <div sclass="topbar-user">
                <div>
                    <label id="mc_lblUserName"   sclass="topbar-user-name"/>
                    <label id="mc_lblUserBranch" sclass="topbar-user-branch"/>
                </div>
                <label id="mc_lblRoleBadge" sclass="topbar-role-badge"/>
            </div>

            <!-- Sign out -->
            <button id="mc_btnSignOut"
                    label="Sign Out"
                    sclass="btn-signout"/>

        </div>

    </div>

</zk>