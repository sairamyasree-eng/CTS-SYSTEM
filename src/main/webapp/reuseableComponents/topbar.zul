<?page contentType="text/html;charset=UTF-8"?>


<zk>
 <style src="/styling/topbar.css"/>
    <div sclass="cts-topbar">

        <!-- Brand -->
        <div sclass="topbar-brand">
            <div sclass="topbar-logo">
                <label sclass="topbar-logo-text" value="CTS"/>
            </div>
            <vlayout spacing="0px">
                <label sclass="topbar-title"    value="CTS Portal"/>
                <label sclass="topbar-subtitle" value="CHEQUE TRUNCATION SYSTEM"/>
            </vlayout>
        </div>

        <!-- Right section -->
        <div sclass="topbar-right">

            <!-- Session badge (hidden by default) -->
            <div id="mc_sessionBadge" sclass="topbar-session" visible="false">
                <label id="mc_lblSessionId"   sclass="session-id"/>
                <label sclass="session-sep"   value="|"/>
                <label id="mc_lblSessionTime" sclass="session-time"/>
                <label sclass="session-sep"   value="|"/>
                <label id="mc_lblSessionDate" sclass="session-date"/>
            </div>

            <!-- User info -->
            <div sclass="topbar-user">
                <vlayout spacing="0px">
                    <label id="mc_lblUserName"   sclass="topbar-user-name"/>
                    <label id="mc_lblUserBranch" sclass="topbar-user-branch"/>
                </vlayout>
                <label id="mc_lblRoleBadge" sclass="topbar-role-badge role-default"/>
            </div>

            <!-- Sign out -->
            <button id="mc_btnSignOut" sclass="btn-signout" label="Sign Out"/>

        </div>
    </div>
</zk>