<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <?link rel="stylesheet" href="/styling/imageViewerPanel.css"?>

    <div id="imgPanelRoot"
         sclass="img-viewer-wrap">

        <!-- Tab bar -->
        <div sclass="img-viewer-tabs">

            <div id="mc_tabFront" sclass="img-tab active">
                <label value="Front"/>
            </div>

            <div id="mc_tabBack" sclass="img-tab">
                <label value="Back"/>
            </div>

            <div id="mc_tabGrayscale" sclass="img-tab">
                <label value="Grayscale"/>
            </div>

        </div>

        <!-- Image display area -->
        <div sclass="img-viewer-body">

            <!-- Front image panel -->
            <div id="mc_panelFront" sclass="img-panel">
                <image id="mc_imgFront" sclass="cheque-img"/>

                <div sclass="img-placeholder"
                     id="mc_placeholderFront">

                    <label value="No front image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

            <!-- Back image panel -->
            <div id="mc_panelBack"
                 sclass="img-panel"
                 visible="false">

                <image id="mc_imgBack"
                       sclass="cheque-img"/>

                <div sclass="img-placeholder"
                     id="mc_placeholderBack">

                    <label value="No back image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

            <!-- Grayscale image panel -->
            <div id="mc_panelGrayscale"
                 sclass="img-panel"
                 visible="false">

                <image id="mc_imgGrayscale"
                       sclass="cheque-img grayscale"/>

                <div sclass="img-placeholder"
                     id="mc_placeholderGrayscale">

                    <label value="No grayscale image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

        </div>

        <!-- Signature comparison panel -->
        <div id="mc_signaturePanel"
             sclass="sig-panel"
             visible="false">

            <label value="SIGNATURE COMPARISON"
                   sclass="sig-panel-title"/>

            <div sclass="sig-row">

                <div sclass="sig-box">

                    <label value="PRESENTED"
                           sclass="sig-box-label"/>

                    <div sclass="sig-img-wrap">

                        <image id="mc_imgSig"
                               sclass="sig-img"/>

                        <div id="mc_placeholderSig"
                             sclass="sig-placeholder">

                            <label value="No signature"
                                   sclass="sig-placeholder-text"/>
                        </div>

                    </div>
                </div>

                <div sclass="sig-box">

                    <label value="BANK RECORD"
                           sclass="sig-box-label"/>

                    <div sclass="sig-img-wrap">

                        <image id="mc_imgBankSig"
                               sclass="sig-img"/>

                        <div id="mc_placeholderBankSig"
                             sclass="sig-placeholder">

                            <label value="No reference"
                                   sclass="sig-placeholder-text"/>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Match result badge -->
            <div id="mc_sigMatchBadge"
                 sclass="sig-match-badge"
                 visible="false">

                <label id="mc_lblSigMatch"
                       sclass="sig-match-label"/>
            </div>

        </div>

    </div>

</zk>