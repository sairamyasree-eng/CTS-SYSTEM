<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <?link rel="stylesheet" href="/styling/imageViewerPanel.css"?>

    <div id="imgPanelRoot"
         sclass="img-viewer-wrap"
         apply="com.iispl.composer.ImageViewerComponent">

        <!-- Tab bar -->
        <div sclass="img-viewer-tabs">

            <!-- Removed onClick="@command('switchTab', tab='front')"
                 Click handling is done in ImageViewerComponent.java using @Listen -->
            <div id="tabFront" sclass="img-tab active">
                <label value="Front"/>
            </div>

            <!-- Removed onClick="@command('switchTab', tab='back')"
                 Click handling is done in ImageViewerComponent.java using @Listen -->
            <div id="tabBack" sclass="img-tab">
                <label value="Back"/>
            </div>

            <!-- Removed onClick="@command('switchTab', tab='grayscale')"
                 Click handling is done in ImageViewerComponent.java using @Listen -->
            <div id="tabGrayscale" sclass="img-tab">
                <label value="Grayscale"/>
            </div>

        </div>

        <!-- Image display area -->
        <div sclass="img-viewer-body">

            <!-- Front image panel -->
            <div id="panelFront" sclass="img-panel">
                <image id="imgFront" sclass="cheque-img"/>
                <div sclass="img-placeholder" id="placeholderFront">
                    <label value="No front image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

            <!-- Back image panel -->
            <div id="panelBack" sclass="img-panel" visible="false">
                <image id="imgBack" sclass="cheque-img"/>
                <div sclass="img-placeholder" id="placeholderBack">
                    <label value="No back image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

            <!-- Grayscale image panel -->
            <div id="panelGrayscale" sclass="img-panel" visible="false">
                <image id="imgGrayscale" sclass="cheque-img grayscale"/>
                <div sclass="img-placeholder" id="placeholderGrayscale">
                    <label value="No grayscale image available"
                           sclass="img-placeholder-text"/>
                </div>
            </div>

        </div>

        <!-- Signature comparison panel -->
        <div id="signaturePanel"
             sclass="sig-panel"
             visible="false">

            <label value="SIGNATURE COMPARISON"
                   sclass="sig-panel-title"/>

            <div sclass="sig-row">

                <div sclass="sig-box">
                    <label value="PRESENTED"
                           sclass="sig-box-label"/>

                    <div sclass="sig-img-wrap">
                        <image id="imgSig"
                               sclass="sig-img"/>

                        <div id="placeholderSig"
                             sclass="sig-placeholder">

                            <label value="No signature"
                                   sclass="sig-placeholder-text"/>
                        </div>
                    </div>
                </div>

                <div sclass="sig-box">
                    <label value="BANK RECORD"
                           sclass="sig-box-label"/>

                    <div sclass="sig-img-wrap">
                        <image id="imgBankSig"
                               sclass="sig-img"/>

                        <div id="placeholderBankSig"
                             sclass="sig-placeholder">

                            <label value="No reference"
                                   sclass="sig-placeholder-text"/>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Match result badge -->
            <div id="sigMatchBadge"
                 sclass="sig-match-badge"
                 visible="false">

                <label id="lblSigMatch"
                       sclass="sig-match-label"/>
            </div>

        </div>

    </div>

</zk>