<?xml version="1.0" encoding="UTF-8"?>
<?page title="Cheque Truncation System - Register"
      contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul">
    <?link rel="stylesheet" type="text/css" href="/styling/login.css"?>

    <div sclass="cts-body" apply="com.iispl.controller.RegisterController">

        <div sclass="bg-overlay"/>

        <div sclass="login-wrapper">

            <!-- Logo -->
            <div sclass="login-logo">
                <div sclass="logo-icon">
                    <label value="?" sclass="logo-question-mark"/>
                </div>
            </div>

            <!-- Title -->
            <div sclass="login-title-block">
                <label value="Cheque Truncation System"
                       sclass="login-title"/>
                <label value="NATIONAL PAYMENTS CORPORATION OF INDIA"
                       sclass="login-subtitle"/>
            </div>

            <!-- Register Card -->
            <div sclass="login-card">

                <!-- Username -->
                <div sclass="form-group">
                    <label value="USERNAME" sclass="form-label"/>
                    <textbox id="txtUsername"
                             sclass="form-input"
                             width="100%"
                             maxlength="50"
                             placeholder="Enter username"/>
                </div>

                <!-- Password -->
                <div sclass="form-group">
                    <label value="PASSWORD" sclass="form-label"/>
                    <textbox id="txtPassword"
                             type="password"
                             sclass="form-input"
                             width="100%"
                             maxlength="50"
                             placeholder="Enter password"/>
                </div>

                <!-- Confirm Password -->
                <div sclass="form-group">
                    <label value="CONFIRM PASSWORD" sclass="form-label"/>
                    <textbox id="txtConfirmPassword"
                             type="password"
                             sclass="form-input"
                             width="100%"
                             maxlength="50"
                             placeholder="Confirm password"/>
                </div>

                <!-- Role -->
                <div sclass="form-group">
                    <label value="ROLE" sclass="form-label"/>
                    <listbox id="cmbRole"
                             mold="select"
                             width="100%"
                             sclass="form-select">
                        <listitem label="Select Role"     value=""/>
                        <listitem label="Admin"           value="ADMIN"/>
                        <listitem label="Maker Outward"   value="MAKER_OUTWARD"/>
                        <listitem label="Checker Outward" value="CHECKER_OUTWARD"/>
                        <listitem label="Maker Inward"    value="MAKER_INWARD"/>
                        <listitem label="Checker Inward"  value="CHECKER_INWARD"/>
                    </listbox>
                </div>

                <div sclass="form-divider"/>

                <!-- Register Button -->
                <button id="btnRegister"
                        label="REGISTER"
                        width="100%"
                        sclass="btn-signin"/>

                <!-- Back to Login -->
                <button id="btnGoLogin"
                        label="Back to Login"
                        width="100%"
                        sclass="btn-secondary"/>

                <!-- Messages -->
                <label id="lblError"
                       visible="false"
                       value=""
                       sclass="error-message"/>

                <label id="lblSuccess"
                       visible="false"
                       value=""
                       sclass="success-message"/>

            </div>

            <!-- Footer -->
            <div sclass="login-footer">
                <label value="CTS V3.1"/>
                <label value="·" sclass="footer-sep"/>
                <label value="NPCI GRID NODE"/>
            </div>

        </div>

    </div>

</zk>