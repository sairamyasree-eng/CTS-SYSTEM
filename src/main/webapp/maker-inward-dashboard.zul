<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS — Maker Inward Dashboard" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul">

	<style src="/styling/maker-inward.css" />

	<?component name="statcard"
        macroURI="/reuseableComponents/statCard.zul"
        class="com.iispl.components.StatCard"?>

	<?component name="modulecard"
        macroURI="/reuseableComponents/moduleCard.zul"
        class="com.iispl.components.ModuleCard"?>
        
    <?component name="topbar"
        macroURI="/reuseableComponents/topbar.zul"
        class="com.iispl.components.TopbarComponent"?>
        
    <?component name="sidebar"
        macroURI="/reuseableComponents/sidebar.zul"
        class="com.iispl.components.SidebarComponent"?>

	<borderlayout width="100%" height="100%"
		apply="com.iispl.controller.MakerInwardDashboardController">

		<west width="220px" splittable="false" collapsible="false">
			<sidebar/>
		</west>

		<center border="none" autoscroll="true">

			<vlayout width="100%" spacing="0">

				<topbar style="width:100%"/>

				<div sclass="dash-page">

					<div sclass="stats-layout">
						<statcard cardColor="amber"
							statId="lblBpxfStatus" statNumber="Pending"
							statLabel="BPXF STATUS" />
						<statcard cardColor="blue" statId="lblParsed"
							statNumber="0" statLabel="PARSED" />
						<statcard cardColor="purple"
							statId="lblSentChecker" statNumber="0"
							statLabel="SENT TO CHECKER" />
					</div>

					<label value="ACCESSIBLE MODULES"
						sclass="section-title" />

					<div sclass="mod-row">
						<modulecard icon="📥" stepLabel="STEP 4"
							moduleTitle="File Processing"
							moduleDesc="Select and parse BPXF inward files received from NPCI. Auto-creates inward cheque records."
							moduleHref="/dem.zul" moduleAction="Open →" />
						<modulecard icon="🔧" stepLabel="STEP 5"
							moduleTitle="Inward Repair"
							moduleDesc="Review inward cheques with MICR issues. Edit MICR fields and send corrected cheques for Checker verification."
							moduleHref="/inward-repair.zul" moduleAction="Open →" />
						<modulecard icon="📋" stepLabel="STEP 8"
							moduleTitle="Batch Status"
							moduleDesc="View current status of all inward and outward batches across the CTS pipeline."
							moduleHref="/view-batches.zul" moduleAction="Open →" />
					</div>

				</div>

			</vlayout>

		</center>

	</borderlayout>

</zk>