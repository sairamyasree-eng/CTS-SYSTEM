<?page title="CTS — Maker Outward Dashboard" contentType="text/html;charset=UTF-8"?>
<!--
    PAGE: makerOutwardDashboard.zul
    ================================
    Role     : MakerOutward
    Modules  : Scan Service → Reject & Repair → Batch Status
    Composer : com.cts.web.composer.dashboard.MakerOutwardDashboardComposer

    Reusable components declared below via <?component?> and used as custom tags.
    Each component maps to its macroURI file and a backing Java composer class.
-->
<zk>

    <!-- ── Declare reusable components ── -->
    <?component name="ctstopbar"
                macroURI="/components/topbar.zul"
                class="com.cts.web.composer.components.TopbarComposer"?>

    <?component name="ctssidebar"
                macroURI="/components/sidebar.zul"
                class="com.cts.web.composer.components.SidebarComposer"?>

    <?component name="workflowbar"
                macroURI="/components/workflowProgressBar.zul"
                class="com.cts.web.composer.components.WorkflowProgressBarComposer"?>

    <?component name="smarttable"
                macroURI="/components/smartTable.zul"
                class="com.cts.web.composer.components.SmartTableComposer"?>

    <!-- ── Page shell window ── -->
    <window id="winMakerOutward"
            border="none"
            width="100%"
            height="100%"
            sclass="cts-page-shell"
            apply="com.cts.web.composer.dashboard.MakerOutwardDashboardComposer">

        <!-- ════════════════════════════════════
             TOP BAR  (reusable)
             Reads: session["currentUser"], session["currentSession"]
             ════════════════════════════════════ -->
        <ctstopbar/>

        <!-- ════════════════════════════════════
             APP SHELL  — sidebar + content
             ════════════════════════════════════ -->
        <hlayout sclass="app-shell" spacing="0px" width="100%">

            <!-- SIDEBAR (reusable) — currentPage will be set to "dashboard" by composer -->
            <ctssidebar/>

            <!-- MAIN CONTENT -->
            <div sclass="main-content" vflex="1">

                <!-- ── Page Header ── -->
                <div sclass="page-hdr">
                    <div sclass="page-hdr-left">
                        <label sclass="page-breadcrumb" value="CTS / Dashboard"/>
                        <label sclass="page-title"      value="Maker Outward — Dashboard"/>
                        <label sclass="page-sub"        value="Outward cheque scanning, repair and batch dispatch"/>
                    </div>
                    <!-- Quick-action: open new scan -->
                    <button id="btnNewScan"
                            label="+ New Scan Session"
                            sclass="btn btn-primary"
                            onClick="@command('openScanDialog')"/>
                </div>

                <!-- ── Workflow Progress Bar (reusable) ── -->
                <!--
                    Composer will call:
                        bar.setActiveStep("dashboard");
                    so steps show: Scan=pending, Repair=pending, etc.
                -->
                <workflowbar id="wfBar"/>

                <!-- ── KPI Stat Row ── -->
                <hlayout sclass="stat-row" spacing="12px">
                    <div sclass="stat-box blue">
                        <label id="lblTotalScanned" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"    value="Total Scanned Today"/>
                    </div>
                    <div sclass="stat-box amber">
                        <label id="lblPendingRepair" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"     value="Pending Repair"/>
                    </div>
                    <div sclass="stat-box green">
                        <label id="lblAutoApproved" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl"    value="Auto Approved"/>
                    </div>
                    <div sclass="stat-box purple">
                        <label id="lblInBatch" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl" value="In Batch"/>
                    </div>
                    <div sclass="stat-box slate">
                        <label id="lblDemSent" sclass="stat-val" value="0"/>
                        <label sclass="stat-lbl" value="DEM Sent"/>
                    </div>
                </hlayout>

                <!-- ── Quick-Access Module Tiles ── -->
                <div sclass="section-lbl">
                    <label value="YOUR MODULES"/>
                </div>
                <hlayout sclass="mod-grid" spacing="12px">

                    <div sclass="mod-tile" onClick="@command('navigate', page='scan')">
                        <label sclass="mod-tile-step" value="STEP 1"/>
                        <label sclass="mod-tile-title" value="Scan Service"/>
                        <label sclass="mod-tile-desc"
                               value="Initiate a scan session, load cheque images and run IQA / MICR validation."/>
                        <label sclass="mod-tile-action" value="Go to Scan →"/>
                    </div>

                    <div sclass="mod-tile" onClick="@command('navigate', page='repair')">
                        <label sclass="mod-tile-step" value="STEP 2"/>
                        <label sclass="mod-tile-title" value="Reject &amp; Repair"/>
                        <label sclass="mod-tile-desc"
                               value="Review flagged cheques, correct field errors, reject irreparable items."/>
                        <label sclass="mod-tile-action" value="Go to Repair →"/>
                    </div>

                    <div sclass="mod-tile" onClick="@command('navigate', page='view-batches')">
                        <label sclass="mod-tile-step" value="STEP 8"/>
                        <label sclass="mod-tile-title" value="Batch Status"/>
                        <label sclass="mod-tile-desc"
                               value="Monitor batches sent to Checker, DEM file dispatch status and NPCI acknowledgements."/>
                        <label sclass="mod-tile-action" value="View Batches →"/>
                    </div>

                </hlayout>

                <!-- ── Recent Cheques Smart Table (reusable) ── -->
                <!--
                    Composer wires this and calls:
                        tableComp.setColumns(...)
                        tableComp.setData(recentCheques)
                        tableComp.setFilterKey("status")
                        tableComp.refresh()
                -->
                <div sclass="card-panel">
                    <div sclass="card-panel-header">
                        <label sclass="card-panel-title" value="RECENT CHEQUES — TODAY"/>
                    </div>
                    <div sclass="card-panel-body">
                        <smarttable id="tblRecentCheques"/>
                    </div>
                </div>

            </div>
            <!-- /main-content -->

        </hlayout>
        <!-- /app-shell -->

    </window>

</zk>